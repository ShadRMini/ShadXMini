{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/api-server",
    "start": "npm run start --workspace=@workspace/api-server",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run typecheck",
    "build:store": "npm run build --workspace=@workspace/xpay-store",
    "build:admin": "npm run build --workspace=@workspace/xpay-admin",
    "build:server": "npm run build --workspace=@workspace/api-server",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "jsonwebtoken": "^9.0.3"
  }
}
